NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cardsbyraaduns
MYSQL_USER=cardsbyraad_usr
MYSQL_PASSWORD=REPLACE_WITH_ROTATED_DATABASE_PASSWORD

KRIPICARD_API_KEY=REPLACE_WITH_ROTATED_KRIPICARD_API_KEY
KRIPICARD_BIN=539502
INTERNAL_JOB_SECRET=REPLACE_WITH_RANDOM_JOB_SECRET

FLUTTERWAVE_SECRET_KEY=REPLACE_WITH_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_WEBHOOK_SECRET=REPLACE_WITH_FLUTTERWAVE_WEBHOOK_SECRET

SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# One-time administrator bootstrap only; do not leave these set after account creation.
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Cards Administrator
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# SMTP outbound email (587 uses STARTTLS)
SMTP_HOST=mail.raaduns.com
SMTP_PORT=587
SMTP_USER=noreply@raaduns.com
SMTP_PASSWORD=
SMTP_FROM=noreply@raaduns.com